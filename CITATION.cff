cff-version: 1.2.0
title: "CRYSS: Crystallisation Research & Yield Simulation Suite"
version: "1.0"
date-released: 2026-09-07
authors:
  - family-names: "Smith"
    given-names: "Alan A."
    orcid: "https://orcid.org/0000-0000-0000-0000"
abstract: >
  CRYSS is an open-source crystallisation modelling and analysis suite,
  including the CRYSS DOE engine and NODES numerical solver. It provides
  tools for eutectic modelling, optimisation, diagnostics, and experimental
  workflow support. Released under the MIT License.
repository-code: "https://github.com/idiocratease-Iggy/CRYSS-Release-V1.0"
url: "https://cryss.co.uk"
license: "MIT"
keywords:
  - crystallisation
  - modelling
  - eutectics
  - optimisation
  - DOE
  - numerical solvers
  - NODES
  - CRYSS
