.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------
# Environment and secrets
# ------------------------------
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.*
*.secret

# ------------------------------
