build/
dist/
site/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/
wheels/

# PyInstaller outputs
*.spec.bak

# ------------------------------
# Logs and runtime artifacts
# ------------------------------
*.log
logs/
tmp/
temp/
*.tmp

# ------------------------------
# Jupyter / notebooks
# ------------------------------
.ipynb_checkpoints/

# ------------------------------
# IDE / editor / OS files
# ------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

